{
    email {$ADMIN_EMAIL}
    # Obtain and renew public certificates automatically with Let's Encrypt.
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}
{$WEDDING_DOMAIN} {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
    }
    # Do not impose a proxy body-size cap. Wedding uploads are streamed and
    # admitted by available disk space; optional quotas are enforced by the app.
    reverse_proxy memtly:5000
}
