{$WEDDING_DOMAIN} {
    encode zstd gzip
    header {
        Referrer-Policy "no-referrer"
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
    }
    request_body {
        max_size 524288000
    }
    reverse_proxy memtly:5000
}
