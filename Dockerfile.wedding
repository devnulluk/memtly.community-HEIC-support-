# syntax=docker/dockerfile:1
FROM ubuntu:24.04 AS heif
ARG HEIF_VERSION=1.23.1
ARG HEIF_SHA256=0de0327f60fcd47de90d5654c6fe152232738d60d84fe084ec3e0f35e03b166a
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential cmake pkg-config libde265-dev libpng-dev libjpeg-dev libbrotli-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl -fL --retry 3 -o heif.tar.gz https://github.com/strukturag/libheif/releases/download/v${HEIF_VERSION}/libheif-${HEIF_VERSION}.tar.gz \
    && echo "${HEIF_SHA256}  heif.tar.gz" | sha256sum -c - \
    && tar xzf heif.tar.gz --strip-components=1 \
    && cmake -S . -B out -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/heif -DCMAKE_INSTALL_LIBDIR=lib \
       -DWITH_EXAMPLES=ON -DBUILD_TESTING=OFF -DWITH_GDK_PIXBUF=OFF -DENABLE_PLUGIN_LOADING=OFF \
       -DWITH_LIBDE265=ON -DWITH_LIBDE265_PLUGIN=OFF -DWITH_X265=OFF -DWITH_X264=OFF \
       -DWITH_AOM_DECODER=OFF -DWITH_AOM_ENCODER=OFF -DWITH_DAV1D=OFF -DWITH_RAV1E=OFF -DWITH_SvtEnc=OFF \
    && cmake --build out --parallel 2 && cmake --install out
RUN LD_LIBRARY_PATH=/opt/heif/lib /opt/heif/bin/heif-convert examples/example.heic /tmp/example.png \
    && find /tmp -maxdepth 1 -name 'example*.png' -size +0c | grep -q .

FROM node:22-bookworm-slim AS node
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /src
COPY . .
# The manifest is an EmbeddedResource selected at MSBuild evaluation time.
# It MUST exist before .NET evaluates/compiles Core, not merely at runtime.
WORKDIR /src/Memtly.Core/Memtly.Core
RUN npm ci && npm run production && test -s wwwroot/dist/manifest.json
WORKDIR /src
RUN dotnet restore Memtly.Community/Memtly.Community.csproj --locked-mode
ENV WeddingSecurityUpdates=true
RUN dotnet restore Memtly.Community/Memtly.Community.csproj --force-evaluate -p:RestoreLockedMode=false
RUN dotnet publish Memtly.Community/Memtly.Community.csproj -c Release -o /publish --no-restore /p:UseAppHost=false
RUN mkdir -p /publish/build-manifests && \
    find . -name wedding.packages.lock.json -exec sh -c 'cp "$1" "/publish/build-manifests/$(basename "$(dirname "$(dirname "$1")")").packages.lock.json"' sh {} \;

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS final
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libde265-0 libpng16-16t64 libjpeg-turbo8 libbrotli1 zlib1g libstdc++6 libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=heif /opt/heif /opt/heif
ENV PATH="/opt/heif/bin:${PATH}" LD_LIBRARY_PATH="/opt/heif/lib" CODE_BUILT_BY="Newland-Brown wedding fork"
WORKDIR /app
COPY --from=build /publish .
RUN mkdir -p /app/config /data/wedding && chown -R app:app /app /data
USER app
EXPOSE 5000
ENTRYPOINT ["dotnet", "Memtly.Community.dll"]
